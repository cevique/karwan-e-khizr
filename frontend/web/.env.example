# Backend API URL (FastAPI)
# When running on localhost or via mobile (laptop-ip:5173), the Vite dev
# server proxies /api/* to the backend at localhost:8000, so a relative
# URL works everywhere.
VITE_API_URL=/api/v1

# Force mock data even when the backend is reachable (true/false).
# Defaults to false - the real backend endpoints exist and are used by
# default. The app still falls back to mock data automatically if the
# backend is unreachable at request time, regardless of this setting.
VITE_USE_MOCK_DATA=false
