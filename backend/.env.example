# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/karwan

# JWT / Auth
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Request #1 - Intent LLM (project owner's credentials)
REQUEST1_GEMINI_API_KEY=
REQUEST1_GEMINI_MODEL=gemini-1.5-flash
REQUEST1_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REQUEST1_GROQ_API_KEY=
REQUEST1_GROQ_MODEL=llama-3.1-70b-versatile
REQUEST1_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Request #2 - Response LLM (second contributor's credentials)
REQUEST2_GEMINI_API_KEY=
REQUEST2_GEMINI_MODEL=gemini-1.5-flash
REQUEST2_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REQUEST2_GROQ_API_KEY=
REQUEST2_GROQ_MODEL=llama-3.1-70b-versatile
REQUEST2_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Speech-to-text (voice input only)
GROQ_WHISPER_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_WHISPER_BASE_URL=https://api.groq.com/openai/v1

# Predictive ETA
ETA_PROVIDER=local

# Routing
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://router.project-osrm.org

# Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=karwan-e-khizr/1.0

# Rate limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_VALIDATE=30
RATE_LIMIT_CONVERSE=10

# QR signing
QR_SIGNING_KEY=your-qr-signing-key-change-in-production-min-32-chars

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_ENV=development
LOG_LEVEL=INFO